# Compiled/emergency fallback only; normal prompt content lives in GitHub when enabled.
ASSISTANT_SYSTEM_PROMPT=
DEEPSEEK_THINKING_ENABLED=
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_BASE_URL=
# Safe default: disabled. Enable in shadow mode before an authorized enforced rollout.
DEEPSEEK_ROUTING_ENABLED=false
DEEPSEEK_ROUTING_MODE=shadow
DEEPSEEK_ROUTER_TIMEOUT_MS=3000
# Optional number from 0 through 1.
DEEPSEEK_ROUTER_MIN_CONFIDENCE=
SANDBOX_REGION=
VERCEL_OIDC_TOKEN=
GITHUB_CONNECTOR=github/skills-repo
GITHUB_SKILLS_OWNER=alchemy666888
GITHUB_SKILLS_REPO=skill
GITHUB_SKILLS_BRANCH=main
# Optional repository-relative directory. Leave empty to allow the repository root.
GITHUB_SKILLS_PREFIX=skills
# Safe initial rollout defaults. Prompt hierarchy reads and writes remain disabled.
PROMPT_HIERARCHY_ENABLED=false
PROMPT_HIERARCHY_WRITES_ENABLED=false
# Prompt access shares the server-only GitHub connector transport, but uses independently
# validated repository coordinates and a prompts-only path.
GITHUB_PROMPTS_OWNER=alchemy666888
GITHUB_PROMPTS_REPO=skill
GITHUB_PROMPTS_BRANCH=main
GITHUB_PROMPTS_PREFIX=prompts
# Comma-separated canonical numeric Telegram IDs; never forward this to the worker.
PROMPT_OPERATOR_TELEGRAM_IDS=
# Generate independently (for example: openssl rand -base64 32); server-only.
PROMPT_USER_KEY_SECRET=
PROMPT_CACHE_TTL_SECONDS=300
PROMPT_CONFIRMATION_TTL_SECONDS=600
PROMPT_ROUTER_CONFIDENCE_THRESHOLD=0.75
