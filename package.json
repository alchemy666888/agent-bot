{
  "name": "telegram-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm worker:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "test:contracts": "vitest run --passWithNoTests tests/contracts",
    "test:e2e": "playwright test",
    "test:live-preview": "vitest run --passWithNoTests tests/live-preview",
    "worker:build": "esbuild src/worker/cli.ts --bundle --platform=node --format=esm --outfile=dist/worker.mjs"
  },
  "dependencies": {
    "@vercel/sandbox": "^3.3.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.2",
    "vitest": "^5.0.1"
  }
}
