{
  "name": "telegram-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --project=chromium",
    "test:a11y": "playwright test --project=accessibility",
    "test:security": "vitest run --project security",
    "db:generate:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "telegram:webhook:set": "tsx scripts/telegram-webhook-set.ts",
    "telegram:webhook:info": "tsx scripts/telegram-webhook-info.ts",
    "telegram:webhook:delete": "tsx scripts/telegram-webhook-delete.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "grammy": "1.46.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.13",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
