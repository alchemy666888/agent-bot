{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bot.invalid/schemas/prompt-v1.json",
  "title": "Agent Bot repository prompt metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "scope",
    "status",
    "summary",
    "triggers",
    "languages"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "kind": { "enum": ["system", "request"] },
    "scope": { "enum": ["common", "global", "personal"] },
    "status": { "enum": ["active", "disabled"] },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "phrases"],
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" }
        },
        "phrases": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^(\\*|[a-z]{2,3}(-[A-Z]{2})?)$" }
    }
  }
}
